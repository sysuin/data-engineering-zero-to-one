SELECT r.region_name AS region, sum(f.revenue) AS revenue
FROM marts.fct_order_lines AS f
JOIN marts.dim_region AS r ON r.region_key = f.region_key
WHERE f.order_date >= ?
  AND f.order_date < ?
GROUP BY ALL ORDER BY ALL
