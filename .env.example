# Copy to .env and edit. .env is ignored by git; this file is the only one committed.

# Frontline, the support desk's API (Chapter 8). The local server in
# meridian/sources/frontline.py accepts exactly this token; a real service would issue
# you your own, and it would never appear in a file git can see.
FRONTLINE_TOKEN=frontline-demo-token

# Optional overrides. The book's printed output assumes the defaults.
# GROUNDWORK_SEED=20261001
# GROUNDWORK_THREADS=1

# The key Groundwork's pseudonyms are made with (Chapter 24). Any long random string;
# change it and every pseudonym changes. Never commit the real one.
GROUNDWORK_PSEUDONYM_KEY=change-me-to-a-long-random-string
